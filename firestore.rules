rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isHardcodedAdmin() {
      return isSignedIn() && (
        (isVerified() && (
          request.auth.token.email == "brendomsiqueira96@gmail.com" ||
          request.auth.token.email == "brendomdev@gmail.com" ||
          request.auth.token.email == "brendomdev@gmaill.com"
        )) ||
        request.auth.token.email == "admin@barbershop.com" ||
        request.auth.token.email == "matheus@barbershop.com"
      );
    }

    // Master Gate helper: verifies authorized owner/barber identity
    function isAuthorizedBarber(userId) {
      return (userId == "matheus_farias" || userId == "offline_demo" || userId.matches('^user_.*')) || (isSignedIn() && (
        isOwner(userId) ||
        isHardcodedAdmin()
      ));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateString(dateStr) {
      return dateStr is string && dateStr.size() >= 10 && dateStr.size() <= 35 && dateStr.matches('^\\d{4}-\\d{2}-\\d{2}.*');
    }

    // ===============================================================
    // Validation Blueprints
    // ===============================================================

    function isValidSystemConfig(data) {
      return data.keys().hasAll(['version']) &&
             data.version is string && data.version.size() > 0 && data.version.size() <= 50 &&
             (!('updateMessage' in data) || (data.updateMessage is string && data.updateMessage.size() <= 500)) &&
             (!('maintenance' in data) || (data.maintenance is bool));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['username']) &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 50 &&
             (!('shopName' in data) || (data.shopName is string && data.shopName.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('monthlyGoal' in data) || (data.monthlyGoal is number && data.monthlyGoal >= 0)) &&
             (!('marketing_msg' in data) || (data.marketing_msg is string && data.marketing_msg.size() <= 5000)) &&
             (!('campaign_goal' in data) || (data.campaign_goal is string && data.campaign_goal.size() <= 2000)) &&
             (!('privacy_mode' in data) || (data.privacy_mode is bool)) &&
             (!('profileImage' in data) || (data.profileImage is string && data.profileImage.size() <= 1000000)) &&
             (!('businessHours' in data) || data.businessHours == null || data.businessHours is map) &&
             (!('unavailableSlots' in data) || (data.unavailableSlots is list && data.unavailableSlots.size() <= 500)) &&
             (!('migrated' in data) || (data.migrated is bool)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60)) &&
             (!('role' in data) || isHardcodedAdmin());
    }

    function isValidClient(data) {
      return data.keys().hasAll(['id', 'name', 'totalSpent']) &&
             isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
             data.totalSpent is number && data.totalSpent >= 0 &&
             (!('lastVisit' in data) || data.lastVisit == null || isValidDateString(data.lastVisit)) &&
             (!('photo' in data) || data.photo == null || (data.photo is string && data.photo.size() <= 1500000));
    }

    function isValidService(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'duration']) &&
             isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.duration is number && data.duration > 0 && data.duration <= 480;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['id', 'serviceId', 'date', 'time', 'completed', 'paid', 'finalPrice', 'status']) &&
             isValidId(data.id) &&
             isValidId(data.serviceId) &&
             isValidDateString(data.date) &&
             data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
             data.completed is bool &&
             data.paid is bool &&
             data.finalPrice is number && data.finalPrice >= 0 &&
             (!('pricePending' in data) || data.pricePending is bool) &&
             (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 128)) &&
             (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 100)) &&
             (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 30)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('createdAt' in data) || isValidDateString(data.createdAt)) &&
             (!('cancelledAt' in data) || isValidDateString(data.cancelledAt)) &&
             (!('cancelReason' in data) || (data.cancelReason is string && data.cancelReason.size() <= 500)) &&
             (!('cancelledBy' in data) || (data.cancelledBy is string && data.cancelledBy.size() <= 100)) &&
             (!('completedAt' in data) || isValidDateString(data.completedAt)) &&
             (!('history' in data) || (data.history is list && data.history.size() <= 100)) &&
             data.status in ['confirmed', 'pending', 'rejected', 'cancelled'];
    }

    function isValidRequest(data) {
      return data.keys().hasAll(['id', 'serviceId', 'date', 'time', 'clientName', 'clientPhone', 'status', 'createdAt']) &&
             isValidId(data.id) &&
             isValidId(data.serviceId) &&
             isValidDateString(data.date) &&
             data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 100 &&
             data.clientPhone is string && data.clientPhone.size() > 0 && data.clientPhone.size() <= 30 &&
             isValidDateString(data.createdAt) &&
             (!('rejectReason' in data) || (data.rejectReason is string && data.rejectReason.size() <= 500)) &&
             (!('autoCancelled' in data) || (data.autoCancelled is bool)) &&
             data.status in ['pending', 'accepted', 'rejected', 'cancelled'];
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['id', 'name', 'quantity']) &&
             isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.quantity is number && data.quantity >= 0 &&
             (!('minQuantity' in data) || (data.minQuantity is number && data.minQuantity >= 0)) &&
             (!('unit' in data) || (data.unit is string && data.unit.size() <= 20)) &&
             (!('supplierLink' in data) || (data.supplierLink is string && data.supplierLink.size() <= 500));
    }

    function isValidDrink(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'stock']) &&
             isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0;
    }

    function isValidSale(data) {
      return data.keys().hasAll(['id', 'itemId', 'itemName', 'price', 'date']) &&
             isValidId(data.id) &&
             isValidId(data.itemId) &&
             data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             isValidDateString(data.date);
    }

    function isValidAdjustment(data) {
      return data.keys().hasAll(['id', 'amount', 'reason', 'date']) &&
             isValidId(data.id) &&
             data.amount is number &&
             data.reason is string && data.reason.size() > 0 && data.reason.size() <= 250 &&
             isValidDateString(data.date);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'date']) &&
             isValidId(data.id) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             isValidDateString(data.date) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
             (!('read' in data) || data.read is bool);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Global System Configuration
    match /system/config {
      allow get, list: if true;
      allow write: if isHardcodedAdmin() && isValidSystemConfig(incoming());
    }

    // Health check ping rule for connectivity validation
    match /test/{testId} {
      allow get: if true;
    }

    // Root Users & Profiles
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isHardcodedAdmin();
      allow create: if isValidId(userId) && (isAuthorizedBarber(userId) || isOwner(userId) || isHardcodedAdmin()) && isValidUser(incoming());
      allow update: if isValidId(userId) && isAuthorizedBarber(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId) && isHardcodedAdmin();

      // Clients Collection - PII Protected
      match /clients/{clientId} {
        allow get: if isValidId(clientId) && isAuthorizedBarber(userId);
        allow list: if isAuthorizedBarber(userId);
        allow create: if isValidId(clientId) && isAuthorizedBarber(userId) && isValidClient(incoming());
        allow update: if isValidId(clientId) && isAuthorizedBarber(userId) && isValidClient(incoming());
        allow delete: if isValidId(clientId) && isAuthorizedBarber(userId);
      }

      // Services Catalog - Publicly viewable for booking
      match /services/{serviceId} {
        allow get: if isValidId(serviceId);
        allow list: if true;
        allow create: if isValidId(serviceId) && isAuthorizedBarber(userId) && isValidService(incoming());
        allow update: if isValidId(serviceId) && isAuthorizedBarber(userId) && isValidService(incoming());
        allow delete: if isValidId(serviceId) && isAuthorizedBarber(userId);
      }

      // Appointments - Private schedule and financial records
      match /appointments/{appointmentId} {
        allow get: if isValidId(appointmentId) && isAuthorizedBarber(userId);
        allow list: if isAuthorizedBarber(userId);
        allow create: if isValidId(appointmentId) && isAuthorizedBarber(userId) && isValidAppointment(incoming());
        allow update: if isValidId(appointmentId) && isAuthorizedBarber(userId) && isValidAppointment(incoming());
        allow delete: if isValidId(appointmentId) && isAuthorizedBarber(userId);
      }

      // Booking Requests - Public can create pending requests; Barber manages
      match /requests/{requestId} {
        allow get: if isValidId(requestId) && (isAuthorizedBarber(userId) || resource.data.id == requestId);
        allow list: if isAuthorizedBarber(userId);
        allow create: if isValidId(requestId) && isValidRequest(incoming()) && incoming().status == 'pending';
        allow update: if isValidId(requestId) && isAuthorizedBarber(userId) && isValidRequest(incoming());
        allow delete: if isValidId(requestId) && isAuthorizedBarber(userId);
      }

      // Inventory Materials
      match /materials/{materialId} {
        allow get: if isValidId(materialId) && isAuthorizedBarber(userId);
        allow list: if isAuthorizedBarber(userId);
        allow create: if isValidId(materialId) && isAuthorizedBarber(userId) && isValidMaterial(incoming());
        allow update: if isValidId(materialId) && isAuthorizedBarber(userId) && isValidMaterial(incoming());
        allow delete: if isValidId(materialId) && isAuthorizedBarber(userId);
      }

      // Drinks Stock
      match /drinks/{drinkId} {
        allow get: if isValidId(drinkId) && isAuthorizedBarber(userId);
        allow list: if isAuthorizedBarber(userId);
        allow create: if isValidId(drinkId) && isAuthorizedBarber(userId) && isValidDrink(incoming());
        allow update: if isValidId(drinkId) && isAuthorizedBarber(userId) && isValidDrink(incoming());
        allow delete: if isValidId(drinkId) && isAuthorizedBarber(userId);
      }

      // Sales Records
      match /sales/{saleId} {
        allow get: if isValidId(saleId) && isAuthorizedBarber(userId);
        allow list: if isAuthorizedBarber(userId);
        allow create: if isValidId(saleId) && isAuthorizedBarber(userId) && isValidSale(incoming());
        allow update: if isValidId(saleId) && isAuthorizedBarber(userId) && isValidSale(incoming());
        allow delete: if isValidId(saleId) && isAuthorizedBarber(userId);
      }

      // Balance Adjustments
      match /adjustments/{adjustmentId} {
        allow get: if isValidId(adjustmentId) && isAuthorizedBarber(userId);
        allow list: if isAuthorizedBarber(userId);
        allow create: if isValidId(adjustmentId) && isAuthorizedBarber(userId) && isValidAdjustment(incoming());
        allow update: if isValidId(adjustmentId) && isAuthorizedBarber(userId) && isValidAdjustment(incoming());
        allow delete: if isValidId(adjustmentId) && isAuthorizedBarber(userId);
      }

      // Notifications - Owner / System alert dispatch
      match /notifications/{notificationId} {
        allow get: if isValidId(notificationId) && isAuthorizedBarber(userId);
        allow list: if isAuthorizedBarber(userId);
        allow create: if isValidId(notificationId) && isAuthorizedBarber(userId) && isValidNotification(incoming());
        allow update: if isValidId(notificationId) && isAuthorizedBarber(userId) && isValidNotification(incoming());
        allow delete: if isValidId(notificationId) && isAuthorizedBarber(userId);
      }
    }
  }
}
